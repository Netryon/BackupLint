# BackupLint fleet agent image (outbound-only; no Docker socket by default).
# Build from the repository root:
#   docker build -f Dockerfile.agent -t backuplint-agent:local .
#
# Persistent identity + queue must be mounted at /state (see docs/agent-container.md).

# Pin the Debian bookworm slim digest so release images are auditable.
# python:3.12-slim-bookworm @ 2026-09-19 (includes libpcre2 10.42-1+deb12u1).
FROM python:3.12-slim-bookworm@sha256:392307d22300de8b5986851a12d9176dfc0fc073e65bf6523ebd7dcbeb23564e

ARG BACKUPLINT_UID=10001
ARG BACKUPLINT_GID=10001
ARG BACKUPLINT_VERSION=1.0.0
ARG BACKUPLINT_REVISION=unknown

LABEL org.opencontainers.image.title="BackupLint Agent" \
      org.opencontainers.image.description="Outbound fleet agent (CSR enrollment, no Docker socket by default)" \
      org.opencontainers.image.source="https://github.com/Netryon/BackupLint" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${BACKUPLINT_VERSION}" \
      org.opencontainers.image.revision="${BACKUPLINT_REVISION}" \
      org.opencontainers.image.vendor="BackupLint"

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid "${BACKUPLINT_GID}" backuplint \
    && useradd --system --uid "${BACKUPLINT_UID}" --gid backuplint \
        --home-dir /state --shell /usr/sbin/nologin backuplint

WORKDIR /app

COPY pyproject.toml README.md LICENSE ./
COPY src ./src
COPY docker/agent-entrypoint.sh \
     docker/agent-preflight.py \
     ./docker/

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir . \
    && chmod 755 \
        /app/docker/agent-entrypoint.sh \
        /app/docker/agent-preflight.py \
    && mkdir -p /state /config \
    && chown backuplint:backuplint /state \
    && backuplint --version

ENV BACKUPLINT_AGENT_STATE_DIR=/state \
    BACKUPLINT_AGENT_CONTROLLER_URL= \
    BACKUPLINT_AGENT_CA_CERT=/config/ca.crt \
    BACKUPLINT_AGENT_INTERVAL=30 \
    HOME=/state \
    TMPDIR=/tmp \
    PYTHONUNBUFFERED=1

USER backuplint:backuplint

ENTRYPOINT ["/app/docker/agent-entrypoint.sh"]
